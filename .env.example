# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.

# Supabase (Project Settings > API). The anon key is public by design; row level security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Only for the desktop app and `npm run dev`: where the /api functions run.
# Leave empty on Vercel (the web app calls its own /api).
VITE_API_BASE=https://YOUR-APP.vercel.app

# Server only (Vercel functions). Never prefix these with VITE_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=opendeck-music
